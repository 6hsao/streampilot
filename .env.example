# =========================================================
# StreamPilot 环境变量模板
# 用法：复制为 .env 后填入真实值；.env 已被 .gitignore 忽略。
# 严禁把真实密钥、账号、密码写进本文件或提交历史。
# =========================================================

# ---------- 运行环境 ----------
APP_ENV=development            # development | staging | production
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------- 阿里云百炼 / DashScope（LLM） ----------
DASHSCOPE_API_KEY=replace_me
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_PRIMARY_MODEL=qwen-plus
QWEN_FAST_MODEL=qwen-turbo
QWEN_MAX_MODEL=qwen-max

# ---------- 阿里云百炼 / CosyVoice（TTS） ----------
COSYVOICE_MODEL=cosyvoice-v2
COSYVOICE_DEFAULT_VOICE=replace_with_authorized_voice_id
TTS_AUDIO_FORMAT=pcm_16khz_mono_discouraged  # 具体取值以官方文档为准

# ---------- 阿里云百炼 / Fun-ASR（识别，非主链路） ----------
FUN_ASR_MODEL=fun-asr
FUN_ASR_ENABLED=false

# ---------- 内容安全 ----------
ALIYUN_ACCESS_KEY_ID=replace_me
ALIYUN_ACCESS_KEY_SECRET=replace_me
ALIYUN_REGION=cn-hangzhou
CONTENT_SAFETY_ENDPOINT=green-cip.cn-hangzhou.aliyuncs.com
SENSITIVE_WORD_DICT_PATH=./config/sensitive_words

# ---------- 存储 ----------
MYSQL_DSN=mysql+pymysql://user:password@127.0.0.1:3306/streampilot
REDIS_URL=redis://127.0.0.1:6379/0
OSS_BUCKET=replace_me
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# ---------- 抖音开放平台（评论接入） ----------
DOUYIN_APP_ID=replace_me
DOUYIN_APP_SECRET=replace_me
DOUYIN_WEBHOOK_SIGN_KEY=replace_me

# ---------- 本地 Windows 凭据桥 ----------
# 仅在本机运行；不要提交下载/生成的证书与私钥
STREAM_BRIDGE_SHARED_SECRET=replace_me
STREAM_BRIDGE_CLOUD_URL=https://api.example.com

# ---------- 推流（运行时由凭据桥下发，禁止在此硬编码） ----------
RTMP_URL=
RTMP_STREAM_KEY=

# ---------- 可观测性 ----------
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_PORT=9100
